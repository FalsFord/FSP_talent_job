# --- App ---
APP_NAME=FSP Talent Platform
DEBUG=false
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080

# --- Embeddings / FSP ---
EMBEDDING_DIM=384
FSP_MOCK_MODE=true

# --- Postgres ---
POSTGRES_USER=fsp
POSTGRES_PASSWORD=fsp
POSTGRES_DB=fsp
POSTGRES_PORT=5439

DATABASE_URL=postgresql+asyncpg://fsp:fsp@db:5432/fsp

# --- Ports ---
API_PORT=8000

# --- Тестирование и конвейер заданий ---
# Выполнение кода кандидатов (Python/Java). ВЫКЛЮЧЕНО по умолчанию: это не полноценная песочница
# (см. app/tasks/runners/code_runner.py). Включайте только на изолированном сервере; для Java соберите образ с WITH_JDK=1.
CODE_EXEC_ENABLED=false
GRADE_CHANGE_COOLDOWN_DAYS=90
RETAKE_COOLDOWN_DAYS=7
TEST_ITEMS_INITIAL=16
TEST_ITEMS_MICRO=6

# --- RAG / корпус знаний ---
KNOWLEDGE_DIR=/data/ru-test-assignments
EMBEDDING_BACKEND=hash            # hash | fastembed (pip install -r requirements-ml.txt)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Необязательно: LLM для черновиков заданий (OpenAI-совместимый endpoint)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Приглашения ---
INVITATIONS_PER_DAY=20
INVITATION_PAIR_COOLDOWN_DAYS=30
INVITATION_TTL_DAYS=14

# --- Регистрация / почта ---
REQUIRE_EMAIL_VERIFICATION=false  # ТЗ п.2.2(4): в production включить (true)
FRONTEND_URL=http://localhost:8080
MAIL_BACKEND=console              # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@fsp-talent.local

