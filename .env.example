# --- App ---
APP_NAME=FSP Talent Platform
DEBUG=false
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080

# --- Embeddings / FSP ---
EMBEDDING_DIM=384
FSP_MOCK_MODE=true

# --- Postgres ---
POSTGRES_USER=fsp
POSTGRES_PASSWORD=fsp
POSTGRES_DB=fsp
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://fsp:fsp@db:5432/fsp

# --- Ports ---
API_PORT=8000