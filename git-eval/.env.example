# Обязательные. Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(32))"
GITEVAL_API_KEY=
GITEVAL_WEBHOOK_SECRET=

# Куда разрешено слать вебхук (префиксы URL основного бэкенда внутри docker-сети)
GITEVAL_CALLBACK_PREFIXES=http://api:8000/api/v1/internal/git-eval/

GITEVAL_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
GITEVAL_DB_PATH=/data/git_eval.sqlite3
GITEVAL_MAX_REPO_MB=100
GITEVAL_CLONE_TIMEOUT_S=120
GITEVAL_CLONE_DEPTH=300
GITEVAL_WORKERS=2

# Запуск тестов кандидата. По умолчанию ВЫКЛ — читайте раздел «Песочница» в README.
GITEVAL_SANDBOX_ENABLED=0
